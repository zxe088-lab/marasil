rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- دوال مساعدة ----------
    function signedIn() { return request.auth != null; }
    // صاحب التطبيق (يغيّر رمز PIN ويقرأ البلاغات)
    function isAdmin() { return signedIn() && request.auth.uid in ['7KzlcizFv8TrIeqRVqi6BjNoCue2', 'c5yYZKI92rXqwr0cb1gm2HNKdSy2']; }
    function isMember(chatId) {
      return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }
    // هل المستخدم userId حاظر الشخص اللي يطلب؟
    function blockedBy(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/blocked/$(request.auth.uid));
    }
    function validUser() {
      return request.resource.data.size() < 30
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 40)
        && (!('msg' in request.resource.data) || request.resource.data.msg.size() <= 120)
        && (!('photo' in request.resource.data) || request.resource.data.photo.size() < 60000);
    }

    // ---------- المستخدمين ----------
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId && validUser();
      // تغيير رمز PIN مسموح للمالك فقط
      allow update: if signedIn() && request.auth.uid == userId && validUser()
                    && (request.resource.data.pin == resource.data.pin || isAdmin());
      // حذف الحساب (شرط من آبل)
      allow delete: if signedIn() && request.auth.uid == userId;

      // جهات الاتصال: المحظور ما يقدر يضيف نفسه عندك
      match /contacts/{contactId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn()
          && (request.auth.uid == userId || (
            request.auth.uid == contactId && !blockedBy(userId)
            && get(/databases/$(database)/documents/contactRequests/$(userId + '_' + contactId)).data.status == 'pending'
            && getAfter(/databases/$(database)/documents/contactRequests/$(userId + '_' + contactId)).data.status == 'accepted'
            && getAfter(/databases/$(database)/documents/contactRequests/$(userId + '_' + contactId)).data.to == contactId
          ));
      }

      // قائمة الحظر (شرط من آبل)
      match /blocked/{otherId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /contactRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from','to','cat','status','createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.cat is string && request.resource.data.cat.size() <= 100
        && request.resource.data.createdAt is number
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && !blockedBy(request.resource.data.to);
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && !blockedBy(resource.data.from)
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(resource.data.from));
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---------- رموز PIN ----------
    match /pins/{pin} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                    && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) || isAdmin());
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- المحادثات ----------
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && (
        (request.resource.data.get('isGroup', false) == true
          && request.resource.data.owner == request.auth.uid
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() >= 1
          && request.resource.data.members.size() <= 50
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.get('admins', []).size() == 0
          && request.resource.data.get('invites', {}).size() <= 49)
        || (request.resource.data.get('isGroup', false) != true
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && !blockedBy(request.resource.data.members[0])
          && !blockedBy(request.resource.data.members[1])));

      allow update: if signedIn() && (
        (resource.data.get('isGroup', false) == true && (
          // المالك: كل شي، والمالك الجديد لازم يكون عضو
          (resource.data.owner == request.auth.uid
            && request.resource.data.isGroup == true
            && request.resource.data.owner in request.resource.data.members
            && request.resource.data.members.size() <= 50
            && request.resource.data.name.size() <= 40)
          // المدير: الاسم والأعضاء والدعوات، بدون تغيير المالك أو المدراء، وما يشيل المالك
          || (request.auth.uid in resource.data.get('admins', [])
            && request.auth.uid in resource.data.members
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'admins', 'isGroup'])
            && resource.data.owner in request.resource.data.members
            && request.resource.data.members.size() <= 50
            && request.resource.data.name.size() <= 40)
          // أي عضو: آخر رسالة، القراءة، يكتب الآن
          || (request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg', 'lastTs', 'lastFrom', 'lastKind', 'read', 'typing']))
          // عضو (غير المالك) يغادر
          || (request.auth.uid in resource.data.members
            && resource.data.owner != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins'])
            && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
            && !(request.auth.uid in request.resource.data.get('admins', [])))
          // المدعو: يقبل (يضيف نفسه فقط) أو يرفض (يشيل دعوته فقط)
          || (request.auth.uid in resource.data.get('invites', {})
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invites'])
            && request.resource.data.get('invites', {}).diff(resource.data.get('invites', {})).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in request.resource.data.get('invites', {}))
            && (request.resource.data.members == resource.data.members
              || request.resource.data.members.toSet() == resource.data.members.toSet().union([request.auth.uid].toSet()))
            && request.resource.data.members.size() <= 50)
        ))
        || (resource.data.get('isGroup', false) != true
          && request.auth.uid in resource.data.members
          && !blockedBy(resource.data.members[0])
          && !blockedBy(resource.data.members[1])));

      allow delete: if signedIn()
        && resource.data.get('isGroup', false) == true
        && resource.data.owner == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn() && isMember(chatId);
        allow create: if signedIn() && isMember(chatId)
          && request.resource.data.from == request.auth.uid
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 2000)
          && (get(/databases/$(database)/documents/chats/$(chatId)).data.get('isGroup', false) == true
            || (!blockedBy(chatId.split('_')[0]) && !blockedBy(chatId.split('_')[1])));
      }
    }

    // ---------- البلاغات (شرط من آبل) ----------
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.size() <= 10
        && (!('reason' in request.resource.data) || request.resource.data.reason.size() <= 500);
      allow read, delete: if isAdmin();
    }
  }
}
