[Unit]
Description=BPB private photo stories
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bpb-stories
EnvironmentFile=/home/ubuntu/bpb-push/r2.env
Environment=GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/bpb-push/firebase-admin.json
Environment=STORIES_PORT=8788
ExecStart=/usr/bin/node /home/ubuntu/bpb-stories/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=384M
UMask=0077

[Install]
WantedBy=multi-user.target
